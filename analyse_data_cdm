def polyRelation2 (L) :
    """"This fonction returns coefficients from the polynomial regression between the x and y pixel position of the light and the altitude and latitude angles.
    The indexes corespond to the following : 
    0 -> Constant
    1 -> x coefficient
    2 -> x**2 coefficient
    3 -> y coefficient
    4 -> y**2 coefficient
    The first array is the altitude's regression and the second is the azimuth's regression."""
    tempPosX = listConversionx(L)
    tempPosY = listConversiony(L)
    tempAlt = listConversionAlt(L)
    tempAz = listConversionAz(L)
    posX = np.array(tempPosX).reshape((-1, 1))
    posY = np.array(tempPosY).reshape((-1, 1))
    _posX = PolynomialFeatures(degree=2, include_bias=False).fit_transform(posX)
    _posY = PolynomialFeatures(degree=2, include_bias=False).fit_transform(posY)
    pos = np.zeros(shape = (len(_posX), 4))
    for i in range(len(_posX)) :
        templist = np.append(_posX[i],  _posY[i])
        pos[i] = templist
    Alt = np.array(tempAlt)
    Az = np.array(tempAz)
    modelAlt = LinearRegression().fit(pos, Alt)
    modelAz = LinearRegression().fit(pos, Az)
    return [modelAlt.coef_, modelAz.coef_]



