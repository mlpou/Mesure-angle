def polyRelation2 (L) :
    """"Cette procédure retourne les coefficient pour la relation polynomiale entre les positions de x et y et l'angle du pixel.
    Indices et coefficients correspondants :
    0 -> Ordonnée à l'origine
    1 -> Coefficient de x
    2 -> Coefficient de x**2
    3 -> Coefficient de y
    4 -> Coefficient de y**2"""
    tempPosX = listConversionx(L)
    tempPosY = listConversiony(L)
    tempAngles = listConversionAngle(L)
    posX = np.array(tempPosX).reshape((-1, 1))
    posY = np.array(tempPosY).reshape((-1, 1))
    _posX = PolynomialFeatures(degree=2, include_bias=False).fit_transform(posX)
    _posY = PolynomialFeatures(degree=2, include_bias=False).fit_transform(posY)
    pos = np.zeros(shape = (len(_posX), 4))
    for i in range(len(_posX)) :
        templist = np.append(_posX[i],  _posY[i])
        pos[i] = templist
    angles = np.array(tempAngles)
    model = LinearRegression().fit(pos, angles)
    return model.coef_

