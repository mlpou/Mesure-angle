import numpy as np # type: ignore
from sklearn.linear_model import LinearRegression # type: ignore
from sklearn.preprocessing import PolynomialFeatures # type: ignore

def numberToAngle (number,altIterations, altPrecision, azIterations) : 
    # On retourne l'angle selon le nombre dans l'itération
    angle = ((number//azIterations)-altIterations/2)*altPrecision
    return angle


def centerRelation(Angles, posY, posX) :
    Distances = np.array([[]])
    for i in range(len(Angles))  :
        dist = (posY[i]**2 + posX[i]**2)**(1/2)
        Distances.append(dist)
    Distances = np.array(Distances).reshape((-1,1))
    Angles = np.array(Angles)
    model = LinearRegression().fit(Distances, Angles)
    Values = [model.intercept_, model.coef_]
    return Values
