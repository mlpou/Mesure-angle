import numpy as np # type: ignore
from sklearn.linear_model import LinearRegression # type: ignore
from sklearn.preprocessing import PolynomialFeatures # type: ignore
#

alt = 1
precision = 1
az = 2


def numberToAngle (number,altIterations, altPrecision, azIterations) : 
    # On retourne l'angle selon le nombre dans l'itération
    angle = ((number//azIterations)-altIterations/2)*altPrecision
    return angle

def listConversionx (L) : 
    posx = []
    for l in L :
        num = l[0]
        posx.append(num.item())
    return posx

def listConversiony (L) : 
    posy = []
    for l in L :
        num = l[1]
        posy.append(num.item())
    return posy

def listConversionAngle (L) : 
    posa = []
    for l in L :
        posa.append(numberToAngle(l[2], alt, precision, az))
    return posa



# print(polyRelation([1, 2, 3], [1, 4, 9]))

def polyRelation2 (L) :
    """"Cette procédure retourne les coefficient pour la relation polynomiale entre les positions de x et y et l'angle du pixel.
    Indices et coefficients correspondants :
    0 -> Ordonnée à l'origine
    1 -> Coefficient de x
    2 -> Coefficient de x**2
    3 -> Coefficient de y
    4 -> Coefficient de y**2"""
    tempPosX = listConversionx(L)
    tempPosY = listConversiony(L)
    tempAngles = listConversionAngle(L)
    posX = np.array(tempPosX).reshape((-1, 1))
    posY = np.array(tempPosY).reshape((-1, 1))
    _posX = PolynomialFeatures(degree=2, include_bias=False).fit_transform(posX)
    _posY = PolynomialFeatures(degree=2, include_bias=False).fit_transform(posY)
    pos = np.zeros(shape = (len(_posX), 4))
    for i in range(len(_posX)) :
        templist = np.append(_posX[i],  _posY[i])
        pos[i] = templist
    angles = np.array(tempAngles)
    model = LinearRegression().fit(pos, angles)
    return model.coef_

print(polyRelation2([[np.int64(2027), np.int64(1229), 0], [np.int64(160), np.int64(92), 1]]))




