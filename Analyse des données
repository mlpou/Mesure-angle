def polyRelation (posX, Angles) :
    pos = np.array(posX).reshape((-1, 1))
    angles = np.array(Angles)
    _pos = PolynomialFeatures(degree = 2, include_bias=False).fit_transform(pos)
    model = LinearRegression().fit(_pos, angles)
    return model.coef_

