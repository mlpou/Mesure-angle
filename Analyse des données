def Relation2 (posX, posY, Angles) :
    pos = np.zeros(shape = ((len(posX)), 2))
    for i in range (len(posX)) : 
        tempList = [posX[i], posY[i]]
        pos [i] = tempList
    angles = np.array(Angles)
    model = LinearRegression().fit(pos, angles)
    return model.coef_

